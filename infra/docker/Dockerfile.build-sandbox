# Dockerfile.build-sandbox
# Docker image for the peep cloud build sandbox.
#
# This image executes untrusted user code. Security properties baked in:
#   - Non-root user (uid=10000) — no sudo, no CAP_SYS_ADMIN
#   - No SSH server, no package manager caches exposed to users
#   - Telemetry disabled for Flutter and Android SDK
#   - Gradle analytics disabled
#
# In production: pin FROM by digest, not tag.
# Example: FROM ubuntu:22.04@sha256:<digest>
FROM ubuntu:22.04

# Avoid interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive

# ── System dependencies ────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    unzip \
    zip \
    wget \
    openjdk-17-jdk \
    libglu1-mesa \
    xz-utils \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Android SDK ───────────────────────────────────────────────────────────────
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
         -O /tmp/cmdtools.zip && \
    unzip -q /tmp/cmdtools.zip -d "${ANDROID_HOME}/cmdline-tools" && \
    mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" && \
    rm /tmp/cmdtools.zip

# Accept licenses and install required SDK components
RUN yes | "${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager" --licenses && \
    "${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager" \
      "platform-tools" \
      "platforms;android-34" \
      "build-tools;34.0.0"

# Disable Android SDK analytics
RUN mkdir -p ~/.android && \
    echo "count=0" > ~/.android/repositories.cfg && \
    echo "# Auto-generated by peep build image" >> ~/.android/repositories.cfg

# ── Flutter SDK ───────────────────────────────────────────────────────────────
ENV FLUTTER_VERSION=3.24.5
ENV FLUTTER_HOME=/opt/flutter

RUN git clone \
      --depth 1 \
      --branch "${FLUTTER_VERSION}" \
      https://github.com/flutter/flutter.git \
      "${FLUTTER_HOME}" && \
    "${FLUTTER_HOME}/bin/flutter" precache --android && \
    "${FLUTTER_HOME}/bin/flutter" config \
      --no-analytics \
      --no-enable-web \
      --no-enable-ios \
      --no-enable-linux-desktop \
      --no-enable-macos-desktop \
      --no-enable-windows-desktop

# Disable Flutter crash reporting
ENV FLUTTER_SUPPRESS_ANALYTICS=true

# ── Node.js (React Native builds) ─────────────────────────────────────────────
ENV NODE_MAJOR=20
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Disable npm telemetry
RUN npm config set fund false && npm config set audit false

# ── Gradle wrapper warm-up ────────────────────────────────────────────────────
# Pre-download the most common Gradle versions to avoid cold-start download
# inside the build (which would require dl.google.com or services.gradle.org
# access during the build itself — both are allowlisted but slow).
# These are baked into the image layer to improve build start time.
ENV GRADLE_USER_HOME=/root/.gradle
RUN mkdir -p "${GRADLE_USER_HOME}/wrapper/dists"
# Note: actual Gradle distribution download happens at first build;
# the Android Gradle Plugin version determines which Gradle version is needed.
# A future image optimization would pre-bake specific Gradle zips here.

# ── Non-root build user ───────────────────────────────────────────────────────
# All build commands run as uid=10000 (no sudo, no su)
RUN useradd -m -u 10000 -s /bin/bash -d /home/builduser builduser

# ── Environment ──────────────────────────────────────────────────────────────
ENV PATH="${FLUTTER_HOME}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV NODE_ENV=production

# ── Labels (for reaper identification) ───────────────────────────────────────
LABEL peep-image=build-sandbox
LABEL peep-flutter-version=${FLUTTER_VERSION}
LABEL peep-node-version=${NODE_MAJOR}

# Switch to non-root user
USER builduser
WORKDIR /build

# ── Healthcheck / metadata ────────────────────────────────────────────────────
# Containers are created with `sleep infinity` and commands sent via docker exec.
# No ENTRYPOINT/CMD needed for the sandbox itself — the worker manages lifecycle.
CMD ["sleep", "infinity"]

# ── Estimated image sizes ─────────────────────────────────────────────────────
# ubuntu:22.04 base:              ~30 MB compressed
# System deps + OpenJDK 17:      ~350 MB compressed
# Android SDK (platform-34 etc): ~800 MB compressed
# Flutter SDK (Android precache): ~1.2 GB compressed
# Node.js 20:                    ~75 MB compressed
# Total compressed:              ~2.5 GB
#
# Cold start (image present on worker host):
#   docker create + docker cp source + docker start: ~3-5 seconds
#   Actual build time dominates: 3-10 minutes (Flutter) / 4-8 minutes (RN)
