{
  "name": "peep",
  "version": "0.1.0",
  "private": true,
  "description": "AI desktop IDE for Flutter developers",
  "scripts": {
    "dev": "pnpm --filter @peep/desktop dev",
    "test": "pnpm -r test",
    "test:env:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:env:down": "docker compose -f docker-compose.test.yml down -v",
    "build": "pnpm -r build",
    "package": "pnpm --filter @peep/desktop package",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@expo/metro-runtime": "^57.0.7",
    "expo": "^57.0.8",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
